#include <stdio.h>

int main()
{
    int A[100], B[100], C[200];
    int n1, n2;
    int i = 0, j = 0, k = 0;

    printf("Enter size of first array: ");
    scanf("%d", &n1);

    printf("Enter first sorted array:\n");
    for(i = 0; i < n1; i++)
        scanf("%d", &A[i]);

    printf("Enter size of second array: ");
    scanf("%d", &n2);

    printf("Enter second sorted array:\n");
    for(i = 0; i < n2; i++)
        scanf("%d", &B[i]);

    i = 0;
    j = 0;

    // Compare both arrays
    while(i < n1 && j < n2)
    {
        if(A[i] < B[j])
        {
            C[k] = A[i];
            i++;
        }
        else
        {
            C[k] = B[j];
            j++;
        }
        k++;
    }

    // Copy remaining elements of A
    while(i < n1)
    {
        C[k] = A[i];
        i++;
        k++;
    }

    // Copy remaining elements of B
    while(j < n2)
    {
        C[k] = B[j];
        j++;
        k++;
    }

    printf("Merged sorted array:\n");

    for(i = 0; i < n1 + n2; i++)
        printf("%d ", C[i]);

    return 0;
}
